---
import { t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
---

<section
  id="top"
  class="hero-scene relative overflow-hidden pt-40 pb-28 md:pt-52 md:pb-36"
>
  <!-- Sfondo fluido metallico con parallasse -->
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <img
      src="/hero-bg.jpg"
      alt=""
      class="hero-bg absolute inset-0 h-full w-full scale-[1.12] object-cover will-change-transform"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/45 to-black/25"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-cream"></div>
  </div>

  <!-- Onde generate dal mouse -->
  <canvas
    class="hero-ripples pointer-events-none absolute inset-0 z-10 h-full w-full"
    aria-hidden="true"></canvas>

  <div class="relative z-20 mx-auto max-w-6xl px-6 text-center">
    <p class="reveal mb-8 inline-flex items-center gap-2 rounded-full border border-white/25 bg-black/20 px-4 py-1.5 text-xs font-medium uppercase tracking-widest text-white/80 backdrop-blur-sm">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
      </span>
      {tr.hero.badge}
    </p>

    <h1 class="reveal font-display text-[clamp(3.2rem,11vw,8.5rem)] leading-[0.95] font-bold tracking-tight text-white">
      Gianpiero
      <br />
      <span class="text-outline-cream">Leon Palma</span>
    </h1>

    <p class="reveal mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-white/75" style="transition-delay: 150ms;">
      <strong class="font-semibold text-white">{tr.hero.role}</strong>
      {tr.hero.intro}
    </p>

    <div class="reveal mt-10 flex flex-wrap justify-center gap-4" style="transition-delay: 250ms;">
      <a
        href="#work"
        class="rounded-full bg-accent px-8 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-accent-dark"
      >
        {tr.hero.ctaProjects}
      </a>
      <a
        href="#contact"
        class="rounded-full border border-white/30 px-8 py-3.5 text-sm font-semibold text-white transition-colors hover:border-white hover:bg-white hover:text-[#1a191d]"
      >
        {tr.hero.ctaContact}
      </a>
    </div>
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>(".hero-scene");
  const bg = document.querySelector<HTMLElement>(".hero-bg");
  const canvas = document.querySelector<HTMLCanvasElement>(".hero-ripples");

  if (scene && bg && canvas) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = window.matchMedia("(pointer: fine)").matches;
    const ctx = canvas.getContext("2d");

    if (!reduceMotion && ctx) {
      // ---- setup canvas ad alta densita di pixel
      let cw = 0;
      let ch = 0;
      const resize = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        cw = canvas.clientWidth;
        ch = canvas.clientHeight;
        canvas.width = cw * dpr;
        canvas.height = ch * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      resize();
      window.addEventListener("resize", resize);

      // ---- parallasse dello sfondo
      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;

      // ---- onde (ripple)
      type Ripple = {
        x: number;
        y: number;
        r: number;
        maxR: number;
        speed: number;
        alpha: number;
        width: number;
        rot: number;
      };
      const ripples: Ripple[] = [];
      let lastSpawn = 0;
      let lastX = -999;
      let lastY = -999;

      const spawnRipple = (x: number, y: number, big = false) => {
        const rot = Math.random() * Math.PI * 2;
        ripples.push({
          x,
          y,
          r: big ? 10 : 5,
          maxR: big ? 340 : 230,
          speed: big ? 2.2 : 1.8,
          alpha: big ? 0.5 : 0.34,
          width: big ? 2 : 1.4,
          rot,
        });
        ripples.push({
          x,
          y,
          r: big ? 8 : 4,
          maxR: big ? 250 : 170,
          speed: big ? 1.9 : 1.5,
          alpha: big ? 0.3 : 0.2,
          width: 1.1,
          rot: rot + 2.4,
        });
      };

      scene.addEventListener("mousemove", (e) => {
        const rect = scene.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        targetX = (x / rect.width) * 2 - 1;
        targetY = (y / rect.height) * 2 - 1;

        const now = performance.now();
        const dx = x - lastX;
        const dy = y - lastY;
        if (now - lastSpawn > 60 && dx * dx + dy * dy > 800) {
          spawnRipple(x, y);
          lastSpawn = now;
          lastX = x;
          lastY = y;
        }
      });

      scene.addEventListener("click", (e) => {
        const rect = scene.getBoundingClientRect();
        spawnRipple(e.clientX - rect.left, e.clientY - rect.top, true);
      });

      scene.addEventListener("mouseleave", () => {
        targetX = 0;
        targetY = 0;
      });

      // ---- onda ambientale occasionale
      {
        setInterval(() => {
          if (document.hidden || ripples.length > 14) return;
          spawnRipple(
            Math.random() * cw,
            ch * (0.25 + Math.random() * 0.6),
          );
        }, 3200);
      }

      // ---- loop di rendering
      const frame = () => {
        currentX += (targetX - currentX) * 0.06;
        currentY += (targetY - currentY) * 0.06;
        bg.style.transform = `scale(1.12) translate3d(${currentX * -16}px, ${currentY * -12}px, 0)`;

        ctx.clearRect(0, 0, cw, ch);
        ctx.globalCompositeOperation = "lighter";

        for (let i = ripples.length - 1; i >= 0; i--) {
          const p = ripples[i];
          p.r += p.speed;
          const t = p.r / p.maxR;
          if (t >= 1) {
            ripples.splice(i, 1);
            continue;
          }
          const a = p.alpha * (1 - t);

          // archi concentrici come onde di mare
          const arcs: [number, number, number][] = [
            [1.0, 0.0, 1.0],
            [0.78, 2.3, 0.6],
            [1.15, 4.2, 0.4],
          ];
          for (const [scale, offset, fade] of arcs) {
            ctx.beginPath();
            ctx.arc(
              p.x,
              p.y,
              p.r * scale,
              p.rot + offset,
              p.rot + offset + Math.PI * 1.45,
            );
            ctx.strokeStyle = `rgba(200,226,255,${a * 0.5 * fade})`;
            ctx.lineWidth = p.width * (scale === 1.0 ? 1 : 0.75);
            ctx.lineCap = "round";
            ctx.stroke();
          }
        }

        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  }
</script>
