---
import { t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
---

<section id="about" class="relative scroll-mt-24 overflow-hidden">
  <!-- Sfondo fluido tenue -->
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src="/about-bg.jpg"
      alt=""
      class="h-full w-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-cream/90 via-cream/60 to-cream/90"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="grid items-center gap-14 md:grid-cols-2">
      <div class="reveal relative mx-auto">
        <div class="absolute -inset-3 rounded-full border-2 border-ink/15"></div>
        <div class="absolute -inset-6 rounded-full border border-accent/25"></div>
        <img
          src="/photo-hero.jpg"
          alt={tr.hero.photoAlt}
          class="relative h-64 w-64 rounded-full object-cover shadow-2xl ring-4 ring-white/10 transition-transform duration-500 hover:scale-105 md:h-80 md:w-80"
        />
      </div>

      <div>
        <p class="reveal text-xs font-medium uppercase tracking-widest text-accent">
          {tr.about.eyebrow}
        </p>
        <h2 class="reveal mt-3 font-display text-4xl font-bold tracking-tight md:text-5xl">
          {tr.about.heading}
        </h2>
        <div class="reveal mt-6 space-y-4 leading-relaxed text-ink-soft">
          <p>
            {tr.about.p1.pre}<strong class="font-semibold text-ink">{tr.about.p1.role}</strong>{tr.about.p1.post}
          </p>
          <p>{tr.about.p2}</p>
        </div>

        <dl class="reveal mt-10 grid grid-cols-3 gap-6 border-t border-ink/10 pt-8">
          {
            tr.about.stats.map((stat) => (
              <div>
                <dt class="sr-only">{stat.label}</dt>
                <dd class="font-display text-3xl font-bold text-accent md:text-4xl">
                  {stat.value}
                </dd>
                <dd class="mt-1 text-xs font-medium uppercase tracking-wide text-ink-soft">
                  {stat.label}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
